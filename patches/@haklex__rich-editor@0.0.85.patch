+import { $getRoot, $isElementNode, HISTORIC_TAG, SKIP_DOM_SELECTION_TAG, isLexicalEditor } from 'lexical';
+
+// Haklex decorators drop NodeState on import, before BlockIdPlugin assigns IDs.
+export function $restoreBlockIds(value) {
+  const restore = (node, source) => {
+    if (source?.type !== node.getType()) return;
+    const blockId = source.$?.blockId;
+    const current = node.exportJSON();
+    if (typeof blockId === 'string' && blockId && !current.$?.blockId) {
+      node.updateFromJSON({ ...current, $: { ...current.$, blockId } });
+    }
+    if ($isElementNode(node) && Array.isArray(source.children)) {
+      node.getChildren().forEach((child, index) => restore(child, source.children[index]));
+    }
+    if (source.content && typeof node.getContentEditor === 'function') {
+      const child = node.getContentEditor();
+      if (isLexicalEditor(child)) restoreBlockIds(child, source.content);
+    }
+    if (source.cells && typeof node.getCellEditors === 'function') {
+      node.getCellEditors().forEach((child, i) => restoreBlockIds(child, source.cells[i]));
+    }
+  };
+  $getRoot().getChildren().forEach((node, index) => restore(node, value.root.children[index]));
+}
+
+export function restoreBlockIds(editor, value) {
+  if (!value) return;
+  editor.update(() => $restoreBlockIds(value), {
+    discrete: editor.getRootElement() === null ? true : undefined,
+    tag: [HISTORIC_TAG, SKIP_DOM_SELECTION_TAG],
+  });
+}
