{
  "name": "sin-personal-space",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "pnpm build:sdk && node scripts/dev.mjs",
    "dev:web": "pnpm build:sdk && node scripts/dev.mjs --web-only",
    "dev:core": "node scripts/dev.mjs --core-only",
    "dev:check": "node scripts/dev.mjs --check",
    "build:sdk": "pnpm --filter @mx-space/api-client build",
    "build": "pnpm build:sdk && pnpm --filter @sin/web build",
    "lint": "pnpm --filter @sin/web lint",
    "typecheck": "pnpm --filter @sin/web exec tsc --noEmit",
    "typecheck:core": "pnpm --filter @mx-space/core typecheck",
    "verify": "node scripts/verify-dev-config.mjs && node scripts/verify-api.mjs"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.0.1",
    "cross-env": "10.1.0"
  }
}
